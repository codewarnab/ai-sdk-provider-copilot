{
  "name": "ai-sdk-provider-copilot",
  "version": "0.1.3",
  "description": "Community AI SDK provider for GitHub Copilot CLI",
  "author": "codewarnab <dev@codewarnab.in>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewarnab/ai-sdk-provider-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/codewarnab/ai-sdk-provider-copilot/issues"
  },
  "homepage": "https://github.com/codewarnab/ai-sdk-provider-copilot#readme",
  "keywords": [
    "ai",
    "vercel",
    "ai-sdk",
    "provider",
    "github",
    "copilot",
    "copilot-cli",
    "language-model",
    "llm"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js",
      "require": "./dist/cache/index.cjs"
    },
    "./propagation": {
      "types": "./dist/propagation/index.d.ts",
      "import": "./dist/propagation/index.js",
      "require": "./dist/propagation/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "release": "standard-version"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/provider-utils": "^4.0.1"
  },
  "peerDependencies": {
    "@github/copilot-sdk": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@github/copilot-sdk": "file:../copilot-sdk/nodejs",
    "@types/node": "^20.19.26",
    "@vitest/coverage-v8": "^4.0.15",
    "ai": "^6.0.3",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}